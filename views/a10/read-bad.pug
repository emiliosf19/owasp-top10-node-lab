extends ../layout
include ../mixins/lab.pug

block content
  +labHeader('A10', 'Lector de archivos (inseguro)')
  form.mb-3(method="GET" action="/a10/read-bad")
    .input-group
      input.form-control(name="file" value=fileParam)
      button.btn.btn-primary(type="submit") Leer
  if content
    pre= content
  if error
    pre.mt-2= error
