extends ../layout
include ../mixins/lab.pug

block content
  +labHeader('A09', 'Transferencia de registro — log seguro')
  +resultAlert('info', message)
  +resultAlert('warning', alert)
  form.mb-3(method="POST" action="/a09/transfer-good")
    .row.g-2
      .col-auto
        input.form-control(name="username" placeholder="alice")
      .col-auto
        input.form-control(name="recordId" placeholder="identificador sensible")
      .col-auto
        button.btn.btn-primary(type="submit") Transferir
  table.table.table-sm
    thead
      tr
        th Usuario
        th record_id
        th Acción
        th Fecha
    tbody
      each r in records
        tr
          td= r.username
          td: code= r.record_id
          td= r.action
          td= r.timestamp
