extends ../layout
include ../mixins/lab.pug

block content
  +labHeader('A06', 'Recuperar contraseña')
  +resultAlert('info', message)
  if token
    .alert.alert-warning Token (mostrado solo en la demo): #[code= token]
  .card.mx-auto(style="max-width:420px")
    .card-body
      form(method="POST" action="/a06/forgot-password")
        .mb-3
          label.form-label Usuario
          input.form-control(name="username" required)
        button.btn.btn-primary.w-100(type="submit") Enviar enlace
