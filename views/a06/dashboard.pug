extends ../layout
include ../mixins/lab.pug

block content
  +labHeader('A06', 'Panel')
  table.table.table-sm
    tbody
      tr
        td Usuario
        td= user.username
      tr
        td Correo
        td= user.email
      tr
        td Créditos
        td= user.credits
      tr
        td Rol
        td= user.role || 'user'
  a.btn.btn-outline-light.btn-sm(href="/a06/update-profile") Actualizar perfil →
