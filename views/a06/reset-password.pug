extends ../layout
include ../mixins/lab.pug

block content
  +labHeader('A06', 'Restablecer contraseña')
  +resultAlert('info', message)
  .card.mx-auto(style="max-width:420px")
    .card-body
      form(method="POST" action="/a06/reset-password")
        .mb-3
          label.form-label Usuario
          input.form-control(name="username" required)
        .mb-3
          label.form-label Token
          input.form-control(name="token" required)
        .mb-3
          label.form-label Nueva contraseña
          input.form-control(name="newPassword" required)
        button.btn.btn-primary.w-100(type="submit") Restablecer
