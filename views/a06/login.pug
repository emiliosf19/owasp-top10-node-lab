extends ../layout
include ../mixins/lab.pug

block content
  +labHeader('A06', 'Login')
  +resultAlert('danger', error)
  .card.mx-auto(style="max-width:420px")
    .card-body
      form(method="POST" action="/a06/login")
        .mb-3
          label.form-label Usuario
          input.form-control(name="username" placeholder="alice / admin")
        .mb-3
          label.form-label Contraseña
          input.form-control(type="password" name="password")
        button.btn.btn-primary.w-100(type="submit") Entrar
